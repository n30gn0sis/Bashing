# https://editorconfig.org
# Mirrors the shfmt flags in scripts/fmt.sh (-i 2 -ci). Keep the two in sync.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = false

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
