#!/usr/bin/env bash
# netcheck — read-only network connectivity and configuration diagnostic.
#
# Works on Ubuntu/Debian and RHEL/CentOS/Rocky/Alma family systems. It is
# deliberately self-contained: it does not source lib/, so it can be copied to
# any host on its own.
#
# Design notes worth knowing before editing:
#
#   * The core checks have NO hard dependency on `ip`, `ping`, `dig` or
#     `nmcli`. Minimal cloud images routinely lack all of them, and a script
#     built on those tools reports a total outage on a perfectly healthy box.
#     State is read from /proc and /sys instead; external tools are used only
#     as optional enrichment.
#   * All hex and bitwise arithmetic is done in bash `$((16#..))`. Do NOT reach
#     for awk's strtonum()/and() — those are gawk extensions, and Ubuntu ships
#     mawk, where they are fatal errors.
#   * `set -e` is deliberately NOT used. This script runs probes that are
#     *expected* to fail; -e would abort the run on the first one. Each check
#     instead runs in its own subshell and prints its result record.
#
# Exit codes: 0 all clear · 1 one or more checks failed · 64 usage error

set -uo pipefail

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2))); then
  printf 'netcheck: requires bash >= 4.2, found %s\n' "$BASH_VERSION" >&2
  exit 1
fi

NETCHECK_VERSION="0.1.0"

# --- testing seams -----------------------------------------------------------
# Every piece of system state is read through one of these, so the test suite
# can point them at fixture trees and run with no network at all.
PROC_ROOT=${NETCHECK_PROC_ROOT:-/proc}
SYS_ROOT=${NETCHECK_SYS_ROOT:-/sys}
RESOLV_CONF=${NETCHECK_RESOLV_CONF:-/etc/resolv.conf}
OS_RELEASE=${NETCHECK_OS_RELEASE:-/etc/os-release}
SKIP_NET=${NETCHECK_SKIP_NET:-0}

# When any root is redirected we are running against fixtures, so host tools
# and live sockets must not be consulted — they would contradict the fixture.
FIXTURED=0
if [[ $PROC_ROOT != /proc || $SYS_ROOT != /sys ]]; then
  FIXTURED=1
fi

# --- options -----------------------------------------------------------------
OPT_JSON=0
OPT_QUIET=0
OPT_TARGET="github.com"
OPT_EGRESS="1.1.1.1:443,8.8.8.8:443"
OPT_TIMEOUT=3

# Results accumulate here as name<TAB>status<TAB>detail<TAB>suggestion
RESULTS=()

# --- colors ------------------------------------------------------------------
colors_init() {
  if [[ ${NETCHECK_FORCE_COLOR:-0} == 1 ]] ||
    { [[ -z ${NO_COLOR:-} ]] && [[ -t 1 ]]; }; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
  else
    C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW=''
  fi
}

# --- small helpers -----------------------------------------------------------

# have COMMAND — is COMMAND usable? Always false under fixtures.
have() {
  ((FIXTURED)) && return 1
  command -v "$1" >/dev/null 2>&1
}

# slurp FILE — print a file's first line, or fail if unreadable.
slurp() {
  local value
  [[ -r $1 ]] || return 1
  IFS= read -r value <"$1" 2>/dev/null || return 1
  printf '%s' "$value"
}

# emit NAME STATUS DETAIL [SUGGESTION] — print one result record.
emit() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}"
}

is_ipv4() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

# safe_host HOST — reject anything that is not a plain hostname or IP, so it
# can never be interpreted as shell syntax by the /dev/tcp probe.
safe_host() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

# --- distro detection --------------------------------------------------------

detect_family() {
  local id="" id_like="" key value
  if [[ -r $OS_RELEASE ]]; then
    while IFS='=' read -r key value; do
      value=${value%\"}
      value=${value#\"}
      case $key in
        ID) id=$value ;;
        ID_LIKE) id_like=$value ;;
      esac
    done <"$OS_RELEASE"
  fi

  case " $id $id_like " in
    *" rhel "* | *" fedora "* | *" centos "*) printf 'rhel' ;;
    *" debian "* | *" ubuntu "*) printf 'debian' ;;
    *) printf 'unknown' ;;
  esac
}

# suggest KEY — the distro-appropriate remediation hint for a failure.
suggest() {
  case $FAMILY:$1 in
    debian:link) printf 'sudo ip link set <iface> up; then: sudo netplan apply' ;;
    rhel:link) printf 'sudo nmcli device connect <iface>' ;;
    *:link) printf 'bring the interface up with your network manager' ;;

    debian:address) printf 'check /etc/netplan/*.yaml, then: sudo netplan apply' ;;
    rhel:address) printf 'check /etc/NetworkManager/system-connections/, then: sudo nmcli con up <con>' ;;
    *:address) printf 'no IPv4 address is configured on any interface' ;;

    debian:gateway) printf 'add a gateway in /etc/netplan/*.yaml, then: sudo netplan apply' ;;
    rhel:gateway) printf 'sudo nmcli con mod <con> ipv4.gateway <ip>; sudo nmcli con up <con>' ;;
    *:gateway) printf 'no default route is configured' ;;

    debian:dns) printf 'check /etc/systemd/resolved.conf, then: sudo resolvectl flush-caches' ;;
    rhel:dns) printf 'sudo nmcli con mod <con> ipv4.dns "1.1.1.1"; sudo nmcli con up <con>' ;;
    *:dns) printf 'no working nameserver in %s' "$RESOLV_CONF" ;;

    debian:egress) printf 'sudo ufw status verbose (also check upstream firewalls)' ;;
    rhel:egress) printf 'sudo firewall-cmd --list-all (also check upstream firewalls)' ;;
    *:egress) printf 'outbound TCP appears to be blocked' ;;

    *) printf '' ;;
  esac
}

# --- probes ------------------------------------------------------------------

# tcp_probe HOST PORT — 0 open, 1 closed/filtered, 2 skipped.
tcp_probe() {
  local host=$1 port=$2
  ((SKIP_NET || FIXTURED)) && return 2
  safe_host "$host" || return 1
  [[ $port =~ ^[0-9]+$ ]] || return 1

  if command -v timeout >/dev/null 2>&1; then
    # Host and port are passed as arguments, never interpolated into the
    # script text, so a hostile resolv.conf cannot inject shell code. The
    # single quotes are load-bearing for exactly that reason: $0/$1 must be
    # expanded by the inner bash, not by this one.
    # shellcheck disable=SC2016 # deliberate: expansion belongs to the inner shell
    timeout "$OPT_TIMEOUT" bash -c 'exec 3<>/dev/tcp/"$0"/"$1"' "$host" "$port" 2>/dev/null
  else
    (exec 3<>/dev/tcp/"$host"/"$port") 2>/dev/null
  fi
}

# resolve HOST — 0 resolved, 1 failed, 2 skipped. Uses NSS, so it needs no
# external DNS utility and honours nsswitch/hosts exactly as applications do.
resolve() {
  ((SKIP_NET || FIXTURED)) && return 2
  getent ahostsv4 "$1" >/dev/null 2>&1
}

# --- system state readers ----------------------------------------------------

# interfaces — non-loopback interface names.
interfaces() {
  local dir name
  for dir in "$SYS_ROOT"/class/net/*; do
    [[ -e $dir ]] || continue
    name=${dir##*/}
    [[ $name == lo ]] && continue
    printf '%s\n' "$name"
  done
}

# dedupe — pass stdin through, dropping repeats. fib_trie lists an address once
# per routing table, so the same IP shows up more than once.
dedupe() {
  local line seen=""
  while IFS= read -r line; do
    [[ $seen == *"|$line|"* ]] && continue
    seen+="|$line|"
    printf '%s\n' "$line"
  done
}

# local_ipv4 — unique non-loopback IPv4 addresses, one per line.
local_ipv4() {
  local_ipv4_raw | dedupe
}

local_ipv4_raw() {
  local found=0 line addr prev=""

  if have ip; then
    while read -r _ _ _ cidr _; do
      addr=${cidr%%/*}
      is_ipv4 "$addr" || continue
      [[ $addr == 127.* ]] && continue
      printf '%s\n' "$addr"
      found=1
    done < <(ip -4 -o addr show 2>/dev/null)
    ((found)) && return 0
  fi

  # Zero-dependency fallback: local addresses appear in fib_trie as the line
  # preceding a "/32 host" marker.
  if [[ -r $PROC_ROOT/net/fib_trie ]]; then
    while IFS= read -r line; do
      if [[ $line == *"/32 host"* && -n $prev ]]; then
        [[ $prev == 127.* ]] || printf '%s\n' "$prev"
        found=1
      fi
      if [[ $line =~ \|--[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
        prev=${BASH_REMATCH[1]}
      fi
    done <"$PROC_ROOT/net/fib_trie"
    ((found)) && return 0
  fi

  if have hostname; then
    for addr in $(hostname -I 2>/dev/null); do
      is_ipv4 "$addr" && printf '%s\n' "$addr"
    done
  fi
}

# default_routes — "IFACE GATEWAY" per default route; GATEWAY may be "on-link".
default_routes() {
  local iface dest gateway flags rest
  [[ -r $PROC_ROOT/net/route ]] || return 1

  {
    read -r rest || return 1 # discard header
    while read -r iface dest gateway flags rest; do
      [[ $dest == 00000000 ]] || continue
      [[ $flags =~ ^[0-9A-Fa-f]+$ ]] || continue
      (((16#$flags) & 1)) || continue # RTF_UP

      if (((16#$flags) & 2)) && [[ $gateway =~ ^[0-9A-Fa-f]{8}$ ]]; then
        # /proc stores the address little-endian, so read the byte pairs back
        # to front. gawk's strtonum() is unavailable on Ubuntu; bash is not.
        printf '%s %d.%d.%d.%d\n' "$iface" \
          "$((16#${gateway:6:2}))" "$((16#${gateway:4:2}))" \
          "$((16#${gateway:2:2}))" "$((16#${gateway:0:2}))"
      else
        printf '%s on-link\n' "$iface"
      fi
    done
  } <"$PROC_ROOT/net/route"
}

# arp_flags IP — print the ARP cache flags for IP, or fail if absent.
arp_flags() {
  local want=$1 addr flags hwaddr rest
  [[ -r $PROC_ROOT/net/arp ]] || return 1

  {
    read -r rest || return 1 # discard header
    while read -r addr _ flags hwaddr rest; do
      if [[ $addr == "$want" ]]; then
        printf '%s %s' "$flags" "$hwaddr"
        return 0
      fi
    done
    return 1
  } <"$PROC_ROOT/net/arp"
}

nameservers() {
  local keyword value rest
  [[ -r $RESOLV_CONF ]] || return 1
  while read -r keyword value rest; do
    [[ $keyword == nameserver && -n ${value:-} ]] && printf '%s\n' "$value"
  done <"$RESOLV_CONF"
}

search_domains() {
  local keyword rest
  [[ -r $RESOLV_CONF ]] || return 1
  while read -r keyword rest; do
    case $keyword in
      search | domain) printf '%s\n' "$rest" ;;
    esac
  done <"$RESOLV_CONF"
}

# --- checks ------------------------------------------------------------------
# Each check prints one or more result records and is run in a subshell.

check_interfaces() {
  local name oper mtu total=0 up=0 parts=() down=()

  while read -r name; do
    total=$((total + 1))
    oper=$(slurp "$SYS_ROOT/class/net/$name/operstate" || printf 'unknown')
    mtu=$(slurp "$SYS_ROOT/class/net/$name/mtu" || printf '?')
    if [[ $oper == up ]]; then
      up=$((up + 1))
      parts+=("$name up mtu=$mtu")
    else
      down+=("$name $oper")
    fi
  done < <(interfaces)

  if ((total == 0)); then
    emit interfaces fail "no non-loopback interfaces found" "$(suggest link)"
    return
  fi

  if ((up == 0)); then
    emit interfaces fail "no interface is up (${down[*]})" "$(suggest link)"
    return
  fi

  # A down interface is reported but not escalated: hosts routinely carry
  # unused or virtual devices (ifb, veth, docker), and warning on those turns
  # a healthy machine into a false alarm.
  local detail="${parts[*]}"
  if ((${#down[@]} > 0)); then
    detail+=" (down: ${down[*]})"
  fi
  emit interfaces ok "$detail" ""
}

check_address() {
  local addrs=()
  mapfile -t addrs < <(local_ipv4)

  if ((${#addrs[@]} == 0)); then
    emit address fail "no IPv4 address outside 127.0.0.0/8" "$(suggest address)"
  else
    emit address ok "${addrs[*]}" ""
  fi
}

check_gateway() {
  local routes=() entry iface gw
  mapfile -t routes < <(default_routes)

  if ((${#routes[@]} == 0)); then
    emit gateway fail "no default route" "$(suggest gateway)"
    return
  fi

  for entry in "${routes[@]}"; do
    iface=${entry%% *}
    gw=${entry#* }
    if [[ $gw == on-link ]]; then
      emit gateway ok "default on-link via $iface" ""
    else
      emit gateway ok "$gw via $iface" ""
    fi
  done
}

check_gateway_reach() {
  local routes=() entry gw="" arp="" flags
  mapfile -t routes < <(default_routes)

  if ((${#routes[@]} == 0)); then
    emit gateway_reach skip "no default route to test" ""
    return
  fi

  for entry in "${routes[@]}"; do
    gw=${entry#* }
    [[ $gw == on-link ]] && continue

    if arp=$(arp_flags "$gw"); then
      flags=${arp%% *}
      # 0x2 == ATF_COM: the entry is complete, so the gateway answered ARP.
      if [[ $flags =~ ^0x[0-9A-Fa-f]+$ ]] && (((16#${flags#0x}) & 2)); then
        emit gateway_reach ok "$gw resolved in ARP cache (${arp#* })" ""
        return
      fi
      emit gateway_reach warn "$gw present in ARP cache but incomplete" ""
      return
    fi

    if have ping; then
      if ping -c1 -W1 "$gw" >/dev/null 2>&1; then
        emit gateway_reach ok "$gw replies to ping" ""
      else
        emit gateway_reach warn "$gw did not reply to ping (may be filtered)" ""
      fi
      return
    fi

    # An empty ARP cache is normal on an idle host, so this is not a failure.
    emit gateway_reach warn "$gw not in ARP cache (idle host?)" ""
    return
  done

  emit gateway_reach skip "default route is on-link" ""
}

check_egress() {
  local spec host port rc open=0 blocked=() skipped=0

  IFS=',' read -r -a specs <<<"$OPT_EGRESS"
  for spec in "${specs[@]}"; do
    host=${spec%%:*}
    port=${spec##*:}
    [[ -n $host && -n $port ]] || continue

    tcp_probe "$host" "$port"
    rc=$?
    case $rc in
      0)
        open=$((open + 1))
        ;;
      2)
        skipped=1
        ;;
      *)
        blocked+=("$spec")
        ;;
    esac
  done

  if ((skipped)); then
    emit egress skip "network probes disabled" ""
  elif ((open > 0)); then
    emit egress ok "outbound TCP reachable ($open/${#specs[@]} endpoints)" ""
  else
    emit egress fail "no outbound TCP to ${blocked[*]}" "$(suggest egress)"
  fi
}

check_resolver_mode() {
  local servers=() mode="static"
  mapfile -t servers < <(nameservers)

  if ((${#servers[@]} == 0)); then
    emit resolver skip "no nameserver entries to classify" ""
    return
  fi

  case ${servers[0]} in
    127.0.0.53) mode="systemd-resolved (stub)" ;;
    127.0.0.1 | 127.*) mode="local resolver/cache" ;;
  esac

  if [[ $mode == "static" ]] && [[ -e /run/systemd/resolve/resolv.conf ]]; then
    mode="systemd-resolved (direct)"
  fi

  emit resolver ok "$mode" ""
}

check_dns_config() {
  local servers=()
  mapfile -t servers < <(nameservers)

  if ((${#servers[@]} == 0)); then
    emit dns_config fail "no nameserver in $RESOLV_CONF" "$(suggest dns)"
  else
    emit dns_config ok "${servers[*]}" ""
  fi
}

check_dns_resolve() {
  local start="" end="" elapsed=""

  if command -v date >/dev/null 2>&1; then
    start=$(date +%s%N 2>/dev/null)
  fi

  resolve "$OPT_TARGET"
  local rc=$?

  if [[ $rc == 2 ]]; then
    emit dns_resolve skip "network probes disabled" ""
    return
  fi

  if [[ -n $start && $start =~ ^[0-9]+$ ]]; then
    end=$(date +%s%N 2>/dev/null)
    [[ $end =~ ^[0-9]+$ ]] && elapsed=$(((end - start) / 1000000))
  fi

  if ((rc == 0)); then
    if [[ -n $elapsed ]] && ((elapsed > 2000)); then
      emit dns_resolve warn "$OPT_TARGET resolved but took ${elapsed}ms" ""
    elif [[ -n $elapsed ]]; then
      emit dns_resolve ok "$OPT_TARGET resolved in ${elapsed}ms" ""
    else
      emit dns_resolve ok "$OPT_TARGET resolved" ""
    fi
  else
    emit dns_resolve fail "cannot resolve $OPT_TARGET" "$(suggest dns)"
  fi
}

check_nameserver_reach() {
  local servers=() server rc reachable=0 unreachable=() skipped=0 probed=0
  mapfile -t servers < <(nameservers)

  if ((${#servers[@]} == 0)); then
    emit nameserver_reach skip "no nameservers configured" ""
    return
  fi

  for server in "${servers[@]}"; do
    # A loopback stub resolver is reached over the loopback interface; probing
    # it proves nothing about upstream DNS, so it is not counted.
    [[ $server == 127.* ]] && continue
    probed=$((probed + 1))
    tcp_probe "$server" 53
    rc=$?
    case $rc in
      0) reachable=$((reachable + 1)) ;;
      2) skipped=1 ;;
      *) unreachable+=("$server") ;;
    esac
  done

  if ((probed == 0)); then
    emit nameserver_reach skip "only loopback resolvers configured" ""
  elif ((skipped)); then
    emit nameserver_reach skip "network probes disabled" ""
  elif ((${#unreachable[@]} == 0)); then
    emit nameserver_reach ok "all nameservers answer on tcp/53" ""
  else
    # Deliberately a warning: plenty of resolvers serve UDP/53 while dropping
    # TCP/53, so a failure here does not prove DNS is broken.
    emit nameserver_reach warn "no tcp/53 to ${unreachable[*]} (udp may still work)" ""
  fi
}

check_search_domains() {
  local domains=() count
  mapfile -t domains < <(search_domains)

  if ((${#domains[@]} == 0)); then
    emit search_domains ok "none configured" ""
    return
  fi

  local all=()
  read -r -a all <<<"${domains[*]}"
  count=${#all[@]}

  if ((count > 6)); then
    emit search_domains warn "$count search domains; glibc uses only the first 6" ""
  else
    emit search_domains ok "${domains[*]}" ""
  fi
}

check_firewall() {
  local state

  if have firewall-cmd; then
    if state=$(firewall-cmd --state 2>&1); then
      emit firewall ok "firewalld: $state" ""
    else
      emit firewall ok "firewalld present but not running" ""
    fi
    return
  fi

  if have ufw; then
    if ((EUID != 0)); then
      emit firewall skip "ufw present; needs root to read status" ""
    elif state=$(ufw status 2>/dev/null | head -1); then
      emit firewall ok "$state" ""
    else
      emit firewall skip "ufw present but status unavailable" ""
    fi
    return
  fi

  if have nft; then
    if ((EUID != 0)); then
      emit firewall skip "nftables present; needs root to read ruleset" ""
    else
      local rules
      rules=$(nft list ruleset 2>/dev/null | grep -c '^' || true)
      if ((rules == 0)); then
        emit firewall ok "nftables present, no rules loaded" ""
      else
        emit firewall ok "nftables ruleset: $rules line(s)" ""
      fi
    fi
    return
  fi

  emit firewall skip "no ufw/firewalld/nftables found" ""
}

# --- output ------------------------------------------------------------------

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf '%s' "$s"
}

render_human() {
  local record name status detail suggestion label color
  local ok=0 warn=0 fail=0 skip=0

  printf '%snetcheck%s  %s  (%s family)\n\n' \
    "$C_BOLD" "$C_RESET" "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)" "$FAMILY"

  for record in "${RESULTS[@]}"; do
    IFS=$'\t' read -r name status detail suggestion <<<"$record"
    case $status in
      ok)
        label=' ok '
        color=$C_GREEN
        ok=$((ok + 1))
        ;;
      warn)
        label='warn'
        color=$C_YELLOW
        warn=$((warn + 1))
        ;;
      fail)
        label='fail'
        color=$C_RED
        fail=$((fail + 1))
        ;;
      *)
        label='skip'
        color=$C_DIM
        skip=$((skip + 1))
        ;;
    esac

    printf '  %s[%s]%s %-18s %s\n' "$color" "$label" "$C_RESET" "$name" "$detail"
    if [[ -n $suggestion ]]; then
      printf '         %ssuggest:%s %s\n' "$C_DIM" "$C_RESET" "$suggestion"
    fi
  done

  printf '\n  %d ok, %d warn, %d fail, %d skip\n' "$ok" "$warn" "$fail" "$skip"
}

render_json() {
  local record name status detail suggestion i last
  last=$((${#RESULTS[@]} - 1))

  printf '[\n'
  for i in "${!RESULTS[@]}"; do
    IFS=$'\t' read -r name status detail suggestion <<<"${RESULTS[$i]}"
    printf '  {"check": "%s", "status": "%s", "detail": "%s", "suggestion": "%s"}' \
      "$(json_escape "$name")" "$(json_escape "$status")" \
      "$(json_escape "$detail")" "$(json_escape "$suggestion")"
    ((i < last)) && printf ','
    printf '\n'
  done
  printf ']\n'
}

usage() {
  cat <<'EOF'
netcheck — read-only network connectivity diagnostic (Ubuntu + RHEL)

usage: netcheck [OPTIONS]

Options:
  -h, --help           Show this help and exit
  -V, --version        Print the version and exit
      --json           Emit results as JSON instead of a table
  -q, --quiet          Suppress the table; rely on the exit code
      --target HOST    Hostname used for the DNS resolution check
                       (default: github.com)
      --egress LIST    Comma-separated HOST:PORT list for the egress check
                       (default: 1.1.1.1:443,8.8.8.8:443)
      --timeout SECS   Per-probe timeout in seconds (default: 3)
      --no-color       Disable colored output

Exit codes:
  0  all checks passed (warnings and skips are not failures)
  1  at least one check failed
  64 usage error

Environment (testing seams):
  NETCHECK_PROC_ROOT, NETCHECK_SYS_ROOT, NETCHECK_RESOLV_CONF,
  NETCHECK_OS_RELEASE, NETCHECK_SKIP_NET
EOF
}

main() {
  while (($# > 0)); do
    case $1 in
      -h | --help)
        usage
        return 0
        ;;
      -V | --version)
        printf '%s\n' "$NETCHECK_VERSION"
        return 0
        ;;
      --json) OPT_JSON=1 ;;
      -q | --quiet) OPT_QUIET=1 ;;
      --no-color) NO_COLOR=1 ;;
      --target)
        (($# >= 2)) || {
          printf 'netcheck: --target requires a value\n' >&2
          return 64
        }
        OPT_TARGET=$2
        shift
        ;;
      --egress)
        (($# >= 2)) || {
          printf 'netcheck: --egress requires a value\n' >&2
          return 64
        }
        OPT_EGRESS=$2
        shift
        ;;
      --timeout)
        (($# >= 2)) || {
          printf 'netcheck: --timeout requires a value\n' >&2
          return 64
        }
        [[ $2 =~ ^[0-9]+$ ]] || {
          printf 'netcheck: --timeout must be a whole number of seconds\n' >&2
          return 64
        }
        OPT_TIMEOUT=$2
        shift
        ;;
      *)
        printf 'netcheck: unknown option: %s\n' "$1" >&2
        usage >&2
        return 64
        ;;
    esac
    shift
  done

  colors_init
  FAMILY=$(detect_family)

  local check line
  for check in \
    check_interfaces \
    check_address \
    check_gateway \
    check_gateway_reach \
    check_egress \
    check_resolver_mode \
    check_dns_config \
    check_dns_resolve \
    check_nameserver_reach \
    check_search_domains \
    check_firewall; do
    # Each check runs isolated, so a stray non-zero status or unexpected
    # failure inside one cannot abort the whole run.
    while IFS= read -r line; do
      [[ -n $line ]] && RESULTS+=("$line")
    done < <("$check")
  done

  if ((OPT_JSON)); then
    render_json
  elif ((OPT_QUIET == 0)); then
    render_human
  fi

  local record status
  for record in "${RESULTS[@]}"; do
    IFS=$'\t' read -r _ status _ _ <<<"$record"
    [[ $status == fail ]] && return 1
  done
  return 0
}

main "$@"
